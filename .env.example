# Never expose this key in VITE_ variables. A backend proxy must keep it secret.
# Backend-only config — do not prefix these with VITE_.
DOCTOREASE_BASE_URL=https://medconsult.doctorease.co
DOCTOREASE_API_KEY=paste-the-key-here
# Confirm these two API paths from DoctorEase's API documentation.
DOCTOREASE_PRODUCTS_PATH=/api/treatments
DOCTOREASE_PRICE_UPDATE_PATH=/api/treatments/:code/price
VITE_REFRESH_SECONDS=30
